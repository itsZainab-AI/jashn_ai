# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional: enable live venue recommendations and Google Places venue photos.
GOOGLE_MAPS_API_KEY=your_google_maps_places_key
PORT=3000
# Optional: path to the SQLite database (defaults to ./data/jashn.sqlite).
# DATABASE_PATH=./data/jashn.sqlite

# SMTP account email delivery (required for email verification and password reset).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Jashn <accounts@example.com>"
APP_URL=http://localhost:3000
